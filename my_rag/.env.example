# ==================== 必填配置 ====================
# 智谱 AI API Key（必须填写）
ZHIPU_API_KEY=你的智谱 AI API Key

# ==================== MySQL 配置 ====================
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123
MYSQL_DATABASE=rag_db

# ==================== Milvus 配置 ====================
MILVUS_HOST=milvus-standalone
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=doc_rag_collection
VECTOR_DIM=384
TOP_K=3

# ==================== Elasticsearch 配置 ====================
ES_HOST=elasticsearch
ES_PORT=9200
ES_INDEX_NAME=rag_documents
ES_ENABLED=true

# ==================== 混合检索配置 ====================
HYBRID_SEARCH_ENABLED=true
VECTOR_WEIGHT=0.6  # 向量检索权重
KEYWORD_WEIGHT=0.4  # 关键词检索权重

# ==================== Rerank 精排配置 ====================
RERANK_ENABLED=true  # 是否启用 Cross-Encoder 精排（false 时降级为纯 RRF）
RERANK_MODEL=BAAI/bge-reranker-base  # 模型名或本地路径（models/bge-reranker-base）
RECALL_TOP_K=30  # 召回阶段扩量（多路召回各取这么多，再精排）
RERANK_TOP_K=5  # rerank 后最终返回数上限
RERANK_SCORE_THRESHOLD=0.3  # rerank 概率阈值（0~1，低于此值丢弃）
VECTOR_DISTANCE_THRESHOLD=0.5  # 纯向量 COSINE 阈值（无 rerank 时用）

# ==================== Redis 配置 ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL=3600  # 缓存过期时间（秒）
CACHE_ENABLED=true  # 是否启用缓存

# ==================== 文件上传配置 ====================
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=10485760  # 10MB (字节)

# ==================== 智谱 AI 模型配置 ====================
ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
ZHIPU_MODEL=glm-4

# ==================== 本地 GPU 模型配置（可选）====================
# 是否使用本地 GPU 模型（true=本地GPU, false=云端API）
USE_LOCAL_LLM=false

# 本地模型路径（容器内路径，对应 ./models 目录）
LOCAL_MODEL_PATH=/app/models/chatglm3-6b

# 模型名称（chatglm3-6b, qwen-7b, llama2-7b, baichuan2-7b）
LOCAL_MODEL_NAME=chatglm3-6b

# GPU 配置
CUDA_VISIBLE_DEVICES=0  # 使用的 GPU 编号（0 表示第一块 GPU）

# 模型推理参数
MAX_LENGTH=2048  # 最大生成长度
TEMPERATURE=0.7  # 温度参数（0.1-1.0，越小越确定）
TOP_P=0.9  # Top-p 采样参数

# 量化配置（节省显存）
USE_QUANTIZATION=false  # 是否启用量化
QUANTIZATION_BITS=8  # 量化位数（4 或 8）

# ==================== 注意事项 ====================
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 修改 ZHIPU_API_KEY 为你的实际 API Key
# 3. 其他配置使用默认值即可
# 4. 生产环境请修改数据库密码
# 5. GPU 部署请参考: docs/GPU_DEPLOYMENT.md
